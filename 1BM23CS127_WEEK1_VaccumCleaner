def reflex_vacuum(room, location, LEFT, RIGHT):
    actions = []
    if room[location] == 'Dirty':
        actions.append(f"Clean at {location}")
        room[location] = 'Clean'
    else:
        if location == LEFT and room[RIGHT] == 'Dirty':
            actions.append(f"Move to {RIGHT}")
            location = RIGHT
        elif location == RIGHT and room[LEFT] == 'Dirty':
            actions.append(f"Move to {LEFT}")
            location = LEFT
        else:
            actions.append("No action")
    return actions, location

